{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile containing role, verification status, parental consent state, and teacher approval state.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["student", "parent", "teacher", "super_admin"] },
        "isMinor": { "type": "boolean" },
        "guardianEmail": { "type": "string", "maxLength": 254 },
        "guardianUid": { "type": "string", "maxLength": 128 },
        "parentalConsentStatus": { "type": "string", "enum": ["not_required", "pending", "approved"] },
        "teacherApproved": { "type": "boolean" },
        "teacherSpecialty": { "type": "string", "maxLength": 200 },
        "teacherBio": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 40 },
        "bio": { "type": "string", "maxLength": 600 },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "isMinor", "parentalConsentStatus", "teacherApproved", "emailVerified", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator lookup document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "PublicTeacher": {
      "title": "PublicTeacher",
      "description": "Publicly visible non-PII faculty profile for approved teachers.",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "specialty": { "type": "string", "minLength": 2, "maxLength": 200 },
        "bio": { "type": "string", "maxLength": 1000 },
        "languages": { "type": "string", "maxLength": 160 },
        "approved": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "displayName", "specialty", "approved", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Quran and Islamic education course offered by the academy.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "category": { "type": "string", "enum": ["Tajweed", "Hifz", "Nazra", "Tafseer", "Islamic Studies", "Kids Quran"] },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "description": { "type": "string", "minLength": 10, "maxLength": 1200 },
        "durationWeeks": { "type": "number" },
        "scheduleSummary": { "type": "string", "maxLength": 160 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "level", "description", "durationWeeks", "teacherId", "teacherName", "published", "createdAt", "updatedAt"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Student enrollment record linking a student to a course.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "courseId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "guardianId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "completed", "paused"] },
        "progressPercent": { "type": "number" },
        "lastSurah": { "type": "number" },
        "lastAyah": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "courseId", "courseTitle", "status", "progressPercent", "createdAt", "updatedAt"]
    },
    "LiveClass": {
      "title": "LiveClass",
      "description": "Scheduled or active live Quran class session with interactive whiteboard state.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "courseId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "teacherName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "scheduledFor": { "type": "string", "maxLength": 64 },
        "durationMinutes": { "type": "number" },
        "meetingUrl": { "type": "string", "maxLength": 500 },
        "topic": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["scheduled", "live", "completed"] },
        "allowStudentDraw": { "type": "boolean" },
        "boardSurah": { "type": "number" },
        "boardAyah": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "teacherId", "teacherName", "scheduledFor", "durationMinutes", "status", "createdAt", "updatedAt"]
    },
    "WhiteboardStroke": {
      "title": "WhiteboardStroke",
      "description": "Single synchronized drawing stroke, shape, or text annotation on a live class whiteboard.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "tool": { "type": "string", "enum": ["pen", "highlighter", "line", "rect", "circle", "text", "eraser"] },
        "color": { "type": "string", "maxLength": 24 },
        "lineWidth": { "type": "number" },
        "xs": { "type": "array" },
        "ys": { "type": "array" },
        "text": { "type": "string", "maxLength": 300 },
        "seq": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "authorName", "tool", "color", "lineWidth", "xs", "ys", "seq", "createdAt"]
    },
    "ClassroomChatMessage": {
      "title": "ClassroomChatMessage",
      "description": "Real-time chat message or question sent inside a live classroom.",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "senderRole": { "type": "string", "enum": ["student", "parent", "teacher", "super_admin"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "senderName", "senderRole", "message", "createdAt"]
    },
    "ClassroomParticipant": {
      "title": "ClassroomParticipant",
      "description": "Presence and raised-hand status for an attendee in a live classroom.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["student", "parent", "teacher", "super_admin"] },
        "handRaised": { "type": "boolean" },
        "lastActiveAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "handRaised", "lastActiveAt"]
    },
    "LibraryItem": {
      "title": "LibraryItem",
      "description": "Islamic digital library book, guide, or tafseer resource.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 180 },
        "author": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": { "type": "string", "enum": ["Quran & Tajweed", "Tafseer", "Hadith", "Seerah", "Fiqh", "Kids Stories"] },
        "language": { "type": "string", "enum": ["English", "Urdu", "Arabic"] },
        "description": { "type": "string", "maxLength": 1000 },
        "contentPreview": { "type": "string", "maxLength": 4000 },
        "pages": { "type": "number" },
        "published": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "author", "category", "language", "description", "published", "createdBy", "createdAt", "updatedAt"]
    },
    "Lecture": {
      "title": "Lecture",
      "description": "Islamic lecture recording or study session.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 180 },
        "speaker": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": { "type": "string", "maxLength": 80 },
        "durationLabel": { "type": "string", "maxLength": 30 },
        "summary": { "type": "string", "maxLength": 1200 },
        "mediaUrl": { "type": "string", "maxLength": 500 },
        "published": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "speaker", "category", "durationLabel", "summary", "published", "createdBy", "createdAt", "updatedAt"]
    },
    "QuranProgress": {
      "title": "QuranProgress",
      "description": "User Quran reading bookmark, memorization tally, and personal study note.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guardianId": { "type": "string", "maxLength": 128 },
        "surahNumber": { "type": "number" },
        "surahName": { "type": "string", "maxLength": 100 },
        "ayahNumber": { "type": "number" },
        "juzNumber": { "type": "number" },
        "pageNumber": { "type": "number" },
        "note": { "type": "string", "maxLength": 1000 },
        "isBookmark": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "surahNumber", "surahName", "ayahNumber", "juzNumber", "pageNumber", "isBookmark", "updatedAt"]
    },
    "GuardianLink": {
      "title": "GuardianLink",
      "description": "Parental consent and child safety oversight record.",
      "type": "object",
      "properties": {
        "parentUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parentEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "childUid": { "type": "string", "maxLength": 128 },
        "childName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "childAge": { "type": "number" },
        "consentGranted": { "type": "boolean" },
        "dailyLimitMinutes": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["parentUid", "parentEmail", "childName", "childAge", "consentGranted", "createdAt", "updatedAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Contact inquiry submitted to the academy administration.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 160 },
        "message": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["new", "reviewed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "subject", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profiles with strict owner/admin read isolation."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator directory for role verification."
    },
    "/public_teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/PublicTeacher" },
      "description": "Public directory of approved academy teachers without PII."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Academy Quran and Islamic education courses."
    },
    "/enrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/Enrollment" },
      "description": "Student course enrollments and progress tracking."
    },
    "/live_classes/{classId}": {
      "schema": { "$ref": "#/entities/LiveClass" },
      "description": "Live classroom schedule, status, and whiteboard board settings."
    },
    "/live_classes/{classId}/whiteboard_strokes/{strokeId}": {
      "schema": { "$ref": "#/entities/WhiteboardStroke" },
      "description": "Synchronized interactive whiteboard strokes for a live class."
    },
    "/live_classes/{classId}/chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ClassroomChatMessage" },
      "description": "Real-time classroom Q&A chat messages."
    },
    "/live_classes/{classId}/participants/{participantId}": {
      "schema": { "$ref": "#/entities/ClassroomParticipant" },
      "description": "Live classroom attendance and raised-hand state."
    },
    "/library_items/{itemId}": {
      "schema": { "$ref": "#/entities/LibraryItem" },
      "description": "Islamic digital library books and guides."
    },
    "/lectures/{lectureId}": {
      "schema": { "$ref": "#/entities/Lecture" },
      "description": "Islamic audio and video lectures."
    },
    "/quran_progress/{progressId}": {
      "schema": { "$ref": "#/entities/QuranProgress" },
      "description": "Personal Quran bookmarks and study notes."
    },
    "/guardian_links/{linkId}": {
      "schema": { "$ref": "#/entities/GuardianLink" },
      "description": "Parental consent and guardian-child supervision records."
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Contact inquiries submitted via the Contact Us page."
    }
  }
}
